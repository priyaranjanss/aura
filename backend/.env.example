# Copy this file to .env and fill in your values.

# --- Server ---
HOST=127.0.0.1
PORT=8001

# --- AI provider ("AI brain") ---
# Choose the backend: groq (default), gemini, openai, or ollama.
AI_PROVIDER=groq
# API key for the chosen provider
# (Groq: https://console.groq.com/keys · Gemini: https://aistudio.google.com/app/apikey)
AI_API_KEY=
# Optional: override the provider's default model
# (e.g. llama-3.3-70b-versatile, gemini-2.0-flash, gpt-4o-mini, llama3.2)
AI_MODEL=
